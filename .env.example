# Copy to .env and fill in. Both keys are optional — see README "Two Modes".

# Cloud mode for the main desk agent (config.yaml: mode: "cloud")
OPENROUTER_API_KEY=

# Background roles (sentinel, writer, audit chat) on OpenAI minis + BOTH voice
# generations (gpt-live-1 via the Live API, gpt-realtime-2.1-mini via Realtime).
# Without this key, text roles fall back to the local model and the voice orb
# is disabled. The project must have access to the audio models
# (check: curl https://api.openai.com/v1/models | grep live).
OPENAI_API_KEY=

# Public demo only (deploy/launch.sh): the two accounts of the sign-in page.
# APP_PASSWORD = login "student" (rotated by every launch), ADMIN_PASSWORD = login "robert".
# LOGIN_ENABLED=1 is added on the server by deploy/setup.sh; leave it out locally.
# APP_PASSWORD=
# ADMIN_PASSWORD=

# Optional: Dynatrace trace export (spans stay local when unset)
# DT_ENDPOINT=https://<env>.live.dynatrace.com/api/v2/otlp/v1/traces
# DT_API_TOKEN=
