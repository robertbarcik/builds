[Unit]
Description=Signal Desk (FastAPI + uvicorn on 127.0.0.1:7870, Caddy in front)
After=network-online.target
Wants=network-online.target

[Service]
User=desk
Group=desk
WorkingDirectory=/opt/signal-desk
# public caps from config.yaml `public:` and no developer hooks; the key and passwords come from .env
Environment=SIGNAL_DESK_PUBLIC=1
ExecStart=/opt/signal-desk/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 7870 --log-level warning --timeout-graceful-shutdown 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
